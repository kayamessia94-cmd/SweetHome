# Copy this file to .env and edit it
PORT=3000

# Public address of the site. For phone tests use your computer's Wi-Fi address
# (e.g. http://192.168.1.20:3000) or an ngrok / Render https address.
BASE_URL=http://localhost:3000

# Any long random text
JWT_SECRET=change-this-to-a-long-random-text

# The account with this email becomes the admin (seller) when it registers
ADMIN_EMAIL=kayamessia94@gmail.com

# Flutterwave keys (dashboard > Settings > API keys). Leave FLW_SECRET_KEY empty
# to use the built-in simulated Mobile Money payment (test mode).
FLW_SECRET_KEY=
FLW_SECRET_HASH=
CURRENCY=UGX
